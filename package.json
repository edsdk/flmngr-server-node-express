{
  "name": "@edsdk/flmngr-server-node-express",
  "description": "Include the Flmngr file manager server side into your Express website or app",
  "version": "1.0.0",
  "private": false,
  "author": {
    "name": "EdSDK",
    "url": "https://edsdk.com/"
  },
  "homepage": "https://flmngr.com",
  "repository": "https://github.com/edsdk/flmngr-server-node-express",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/stamp-module-type.mjs"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@edsdk/flmngr-server-node": "^1.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5"
  },
  "peerDependencies": {
    "express": ">=4.0.0 <6"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "express": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "file-manager",
    "fileManager",
    "file",
    "image",
    "manager",
    "server",
    "express",
    "node"
  ]
}
